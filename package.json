{
    "name": "prosemirror",
    "version": "1.0.0",
    "description": "prosemirror Plugin for DokuWiki",
    "private": true,
    "dependencies": {
        "prosemirror-commands": "^1.0.7",
        "prosemirror-history": "^1.0.4",
        "prosemirror-inputrules": "^1.0.4",
        "prosemirror-keymap": "^1.0.1",
        "prosemirror-model": "^1.7.0",
        "prosemirror-schema-basic": "^1.0.1",
        "prosemirror-schema-list": "^1.0.3",
        "prosemirror-state": "^1.2.3",
        "prosemirror-tables": "^0.8.0",
        "prosemirror-transform": "^1.1.3",
        "prosemirror-view": "^1.42.7"
    },
    "devDependencies": {
        "esbuild": "^0.28.2"
    },
    "scripts": {
        "build": "esbuild script/main.js --bundle --format=iife --target=es2020 --minify --outfile=lib/bundle.js",
        "dev": "esbuild script/main.js --bundle --format=iife --target=es2020 --sourcemap=inline --outfile=lib/bundle.js",
        "watch": "npm run dev -- --watch",
        "test": "esbuild _jstest/test.js --bundle --platform=node --outfile=_jstest/test.bundle.cjs --log-level=warning && node --test _jstest/test.bundle.cjs"
    },
    "author": "",
    "license": "GPL-2.0"
}
