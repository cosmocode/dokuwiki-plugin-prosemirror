{
    "name": "prosemirror",
    "version": "1.0.0",
    "description": "prosemirror Plugin for DokuWiki",
    "private": true,
    "type": "module",
    "dependencies": {
        "prosemirror-commands": "^1.7.2",
        "prosemirror-history": "^1.5.1",
        "prosemirror-inputrules": "^1.5.1",
        "prosemirror-keymap": "^1.2.3",
        "prosemirror-model": "^1.25.12",
        "prosemirror-schema-basic": "^1.2.5",
        "prosemirror-schema-list": "^1.6.0",
        "prosemirror-state": "^1.4.4",
        "prosemirror-tables": "^1.8.5",
        "prosemirror-transform": "^1.12.4",
        "prosemirror-view": "^1.42.9"
    },
    "devDependencies": {
        "esbuild": "^0.28.2"
    },
    "scripts": {
        "build": "esbuild script/main.js --bundle --format=iife --target=es2020 --minify --outfile=lib/bundle.js",
        "dev": "esbuild script/main.js --bundle --format=iife --target=es2020 --sourcemap=inline --outfile=lib/bundle.js",
        "watch": "npm run dev -- --watch",
        "test": "node --test _jstest/test.js"
    },
    "author": "",
    "license": "GPL-2.0"
}
